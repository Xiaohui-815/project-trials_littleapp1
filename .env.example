# Only public configuration belongs in VITE_* variables. Never put a secret here.
VITE_CLOUDBASE_ENV_ID=
VITE_CLOUDBASE_REGION=ap-shanghai
VITE_CLOUDBASE_PUBLISHABLE_KEY=
# Exact CloudBase hosted authentication URL copied from the console.
VITE_CLOUDBASE_AUTH_URL=
VITE_CLOUDBASE_FUNCTION_NAME=points-ledger
# GitHub Pages project path, with leading and trailing slash.
VITE_BASE_PATH=/project-trials_littleapp1/
